# Public URL is embedded at BUILD time. Rebuild when changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Restricted application connection (never use migration/admin credentials here).
# URL-encode special characters in credentials. No Prisma ?schema= parameter.
DATABASE_URL=postgresql://shivass_app:replace_me@127.0.0.1:5432/shivasspack

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=shivass_session
SESSION_TTL_DAYS=30

# Optional integrations (not implemented yet); blank values are accepted.
REDIS_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=shivasspack
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
AI_PROVIDER=none
AI_API_KEY=
INSTALLER_SIGNING_KEY=
CRON_SECRET=

# Mail delivery. Unset transport: "file" outside production, "none" in production.
# "file" writes messages to MAIL_OUTBOX_DIR (local development).
# "smtp" requires SMTP_HOST; SMTP_PORT/SMTP_SECURE default to 587 / port===465.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_OUTBOX_DIR=.mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Docker Compose bootstrap only. Use a random HEX password so it is URL-safe.
# Store DATABASE_MIGRATION_URL in ignored .env.migrations, not this file.
# DATABASE_ADMIN_URL is passed only to db:provision in the operator's environment.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
