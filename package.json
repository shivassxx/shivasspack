{
  "name": "shivass-pack",
  "version": "1.0.0",
  "private": true,
  "description": "SHIVASS PACK — FiveM graphics, PvP, ReShade & ENB community platform",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:provision": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrations --import tsx scripts/provision-db.ts",
    "db:migrate": "node --env-file-if-exists=.env.migrations --import tsx src/db/migrate.ts",
    "db:studio": "node --env-file-if-exists=.env.migrations node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file-if-exists=.env.migrations --import tsx src/db/seed.ts",
    "db:test": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrations --import tsx --test src/db/database.integration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.10",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
